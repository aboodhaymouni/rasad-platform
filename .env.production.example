# ──────────────────────────────────────────────────────────────
#  RASAD Frontend — PRODUCTION env template
#  Copy to .env and adjust to your domain.
# ──────────────────────────────────────────────────────────────

# Backend URL behind nginx reverse proxy (HTTPS, your domain)
VITE_RASAD_API_URL=https://yourdomain.com/api/v1

# Supabase (only needed if you use the dashboard / login features)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
