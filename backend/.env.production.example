# ──────────────────────────────────────────────────────────────
#  RASAD Backend — PRODUCTION env template (Hostinger VPS)
#  Copy to backend/.env and fill the *required* keys.
# ──────────────────────────────────────────────────────────────

# ═══ REQUIRED ═══
# Gemini powers the Arabic explanation in A6. Free at:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ═══ STRONGLY RECOMMENDED ═══
# HuggingFace Inference API — saves you from downloading 1.3GB models locally
#   https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Better web search results (free tiers, no card required)
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# ═══ OPTIONAL ═══
# Hive — high-grade AI image detection. Without it, Organika/sdxl-detector runs locally.
HIVE_API_KEY=

# Persist verdicts to Supabase (else in-memory only — lost on restart)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ═══ INFRASTRUCTURE (already set sensibly via docker-compose) ═══
REDIS_URL=redis://redis:6379
GOOGLE_CLOUD_PROJECT=rasad-prod
ENVIRONMENT=production
LOG_LEVEL=INFO
HF_HOME=./hf_cache
TRANSFORMERS_OFFLINE=0

# ═══ FEATURE TUNING ═══
RASAD_PREWARM=1                   # warm models at startup (recommended)
RASAD_LIVE_MONITOR=1              # background RSS scrape every N seconds
LIVE_MONITOR_INTERVAL=240
AGENT_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=86400
A2_AI_DETECTOR_MODEL=Organika/sdxl-detector
GEMINI_MODEL=gemini-2.5-flash

# ═══ CORS — REPLACE WITH YOUR DOMAIN ═══
# Comma-separated list. Use HTTPS only in production.
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
